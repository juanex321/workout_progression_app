# ── FastAPI / Database ─────────────────────────────────────────────────────────

# PostgreSQL connection string (required in production / Railway).
# Omit for local dev — the API will fall back to SQLite automatically.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Set to "true" to force the pg8000 driver (required on Vercel Python runtime).
# FORCE_PG8000=false

# Override runtime environment detection.
# Valid values: "production" | "development"
# APP_ENV=development

# Set to "true" to hard-require DATABASE_URL regardless of hosting markers.
# Useful for staging environments not covered by the auto-detection list.
# REQUIRE_DATABASE_URL=false

# ── Hosting platform markers (set automatically by each platform) ──────────────
# These are detected automatically — do not set them manually unless testing.
# RAILWAY_ENVIRONMENT=production
# VERCEL=1
# RENDER=true
# FLY_APP_NAME=my-app

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
# See frontend/.env.example for frontend-specific variables.
